{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "techclub-icecream",
  "account_id": "d1687fcac82d7199c8c8af57bbe570fc",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "kiosk.jamboree.techclub.pw", "custom_domain": true }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "durable_objects": {
    "bindings": [{ "name": "BOOTH", "class_name": "Booth" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Booth"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "techclub-icecream",
      "database_id": "d33f27c2-ac0c-4650-bcb7-d6d559fa3952",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "CLIENT_LIMITER",
      "namespace_id": "4208",
      "simple": { "limit": 600, "period": 60 }
    },
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "4210",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "triggers": {
    "crons": ["17 9 * * *", "*/10 * * * *"]
  },
  "vars": {
    "LOG_RETENTION_DAYS": "30",
    "SQUARE_ENVIRONMENT": "production",
    "SQUARE_LOCATION_ID": "",
    "SQUARE_CATEGORY_NAME": "TC"
  },
  // Optional secrets, not listed as required so a deploy without them still works (the Square routes then answer
  // 503 not_configured): SQUARE_APPLICATION_ID, SQUARE_APPLICATION_SECRET, SQUARE_ACCESS_TOKEN, STAFF_PIN.
  "secrets": {
    "required": ["BOOTH_TOKEN", "STAFF_TOKEN"]
  },
  "env": {
    "staging": {
      "name": "techclub-icecream-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "kiosk-staging.jamboree.techclub.pw", "custom_domain": true }],
      "observability": { "enabled": true, "head_sampling_rate": 1 },
      "durable_objects": {
        "bindings": [{ "name": "BOOTH", "class_name": "Booth" }]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "techclub-icecream-staging",
          "database_id": "8a4ee0e2-b810-4d69-8ea0-2f8437b27c8a",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        {
          "name": "CLIENT_LIMITER",
          "namespace_id": "4209",
          "simple": { "limit": 600, "period": 60 }
        },
        {
          "name": "LOGIN_LIMITER",
          "namespace_id": "4211",
          "simple": { "limit": 10, "period": 60 }
        }
      ],
      "triggers": { "crons": ["47 9 * * *", "*/10 * * * *"] },
      "vars": {
        "LOG_RETENTION_DAYS": "7",
        "SQUARE_ENVIRONMENT": "sandbox",
        "SQUARE_LOCATION_ID": "LEAK1T7R20090",
        "SQUARE_CATEGORY_NAME": "TC"
      },
      "secrets": { "required": ["BOOTH_TOKEN", "STAFF_TOKEN"] }
    }
  }
}
