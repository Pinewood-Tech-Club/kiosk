{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "techclub-icecream",
  "account_id": "496fbe0bf0003addc2e0116caff5d215",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "durable_objects": {
    "bindings": [{ "name": "BOOTH", "class_name": "Booth" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Booth"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "techclub-icecream",
      "database_id": "0944efa8-228f-4e2b-aa8b-8440f6aab7d0",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "CLIENT_LIMITER",
      "namespace_id": "4208",
      "simple": { "limit": 600, "period": 60 }
    }
  ],
  "triggers": {
    "crons": ["17 9 * * *"]
  },
  "vars": {
    "LOG_RETENTION_DAYS": "30"
  },
  "secrets": {
    "required": ["BOOTH_TOKEN", "STAFF_TOKEN"]
  },
  "env": {
    "staging": {
      "name": "techclub-icecream-staging",
      "workers_dev": true,
      "preview_urls": false,
      "observability": { "enabled": true, "head_sampling_rate": 1 },
      "durable_objects": {
        "bindings": [{ "name": "BOOTH", "class_name": "Booth" }]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "techclub-icecream-staging",
          "database_id": "041125c7-6bfa-4930-92e6-dbbe30ad4ee3",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        {
          "name": "CLIENT_LIMITER",
          "namespace_id": "4209",
          "simple": { "limit": 600, "period": 60 }
        }
      ],
      "triggers": { "crons": [] },
      "vars": { "LOG_RETENTION_DAYS": "7" },
      "secrets": { "required": ["BOOTH_TOKEN", "STAFF_TOKEN"] }
    }
  }
}
