// Copy to Config/Local.xcconfig (gitignored) and fill in.
// Sandbox credentials: https://developer.squareup.com/apps -> your app -> toggle "Sandbox".

PRODUCT_BUNDLE_IDENTIFIER = com.yourname.kiosk
DEVELOPMENT_TEAM = ABCDE12345

SQUARE_APPLICATION_ID = sandbox-sq0idb-xxxxxxxxxxxxxxxxxxxxxx

// Dev fallback only. The kiosk gets its access token and location from the booth backend (Square OAuth) and caches
// them in the Keychain; these two are used only when it has never reached the backend.
SQUARE_ACCESS_TOKEN = EAAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SQUARE_LOCATION_ID = LXXXXXXXXXXXXX

// Catalog category holding "1 Scoop", "2nd Scoop", "3rd+ Scoop" and "Waffle Cone" (each with one fixed-price variation).
// If missing or mismatched, the kiosk falls back to ad-hoc line items and flags it in the debug bar.
SQUARE_CATEGORY_NAME = TC

// Shown on the receipt screen (the Square location's business name is shown above it).
KIOSK_EVENT_NAME = Tech Club Ice Cream

// Staff dashboard backend. BOOTH_URL is a bare host because `//` starts a comment in an xcconfig file.
BOOTH_URL = kiosk.jamboree.techclub.pw
BOOTH_TOKEN = xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

// Optional. The kiosk's name on the staff pages and in alerts until staff rename it there (without it the kiosk shows
// up as "Kiosk 3F2A", from its device id). Kiosk iPads only.
KIOSK_NAME =

// Kiosk iPads. The staff PIN that unlocks the debug bar (Readers, Change role, Log) on the kiosk while the booth is
// unreachable: hold the attract screen's top-left corner for 3 seconds. Without it the corner does nothing.
KIOSK_STAFF_PIN =

// Optional. A staff iPad: KIOSK_ROLE = staff skips role setup and opens the staff web page BOOTH_URL/staff/STAFF_PAGE
// (scooper or toppings; empty means scooper), signed in with BOOTH_STAFF_TOKEN (without it the page asks for the PIN).
// Leave all three empty on the kiosk iPad.
KIOSK_ROLE =
STAFF_PAGE =
BOOTH_STAFF_TOKEN =
