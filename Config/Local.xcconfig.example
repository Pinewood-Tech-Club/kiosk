// Copy to Config/Local.xcconfig (gitignored) and fill in.
// Sandbox credentials: https://developer.squareup.com/apps -> your app -> toggle "Sandbox".

PRODUCT_BUNDLE_IDENTIFIER = com.yourname.kiosk
DEVELOPMENT_TEAM = ABCDE12345

SQUARE_APPLICATION_ID = sandbox-sq0idb-xxxxxxxxxxxxxxxxxxxxxx
SQUARE_ACCESS_TOKEN = EAAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SQUARE_LOCATION_ID = LXXXXXXXXXXXXX

// Catalog category holding "1 Scoop", "2nd Scoop", "3rd+ Scoop" and "Waffle Cone" (each with one fixed-price variation).
// If missing or mismatched, the kiosk falls back to ad-hoc line items and flags it in the debug bar.
SQUARE_CATEGORY_NAME = TC

// Shown on the receipt screen (the Square location's business name is shown above it).
KIOSK_EVENT_NAME = Tech Club Ice Cream
